# Go
/groundtruth
/groundtruth.exe
*.exe
*.test
coverage.out
coverage.html

# Frontend
/web/node_modules/
/web/dist/
/web/coverage/

# Embedded frontend build output (copied from web/dist by `make build-frontend`).
# A placeholder index.html is committed so `go build`/`go vet`/embed always
# have at least one real file to embed, even before the frontend is built.
/internal/webassets/dist/*
!/internal/webassets/dist/index.html

# GoReleaser output (from `goreleaser release`/`build`, including --snapshot)
/dist/

# Local env / secrets
.env
.env.*
!.env.example
*.local
*.env
# The credentials file deploy/docker-compose.yml suggests mounting.
credentials.env

# groundtruth's own runtime state. The default GROUNDTRUTH_DATA_DIR is ./data,
# and the SQLite database in it holds password and token hashes and
# alert-destination secrets - running the binary from a checkout must never
# leave something `git add .` would pick up.
/data/
*.db
*.db-wal
*.db-shm

# Terraform state and modules that end up beside deploy/docker-compose.yml
# when trying groundtruth out from a checkout.
terraform.tfstate*
.terraform/
/deploy/modules/

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Scratch
/tmp/
